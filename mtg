class Vis06(Command, name="vis_06"):
    """Visible 0.6 image."""

    def run(self):
        from pyresample.area_config import load_area

        area = load_area("area.yaml", "euro05")
        self.scene.load(["vis_06"])
        # euro = self.scene.resample("euro4")
        euro = self.scene.resample(area)
        euro.save_dataset("vis_06", "./vis_06.png")


def main():
    parser = argparse.ArgumentParser(description="MTG experiments")
    subparsers = parser.add_subparsers(help="sub-command help", dest="command")
    for command_cls in Command.commands.values():
        subparsers.add_parser(
            command_cls.name, help=_get_first_docstring_line(command_cls)
        )
    args = parser.parse_args()

    command_cls = Command.commands[args.command]

    command = command_cls(Path("raw"))
    command.run()


if __name__ == "__main__":
    main()
